#!/bin/bash

source bin/funcs.sh
banner
RPWD=`pwd`
[ ! -d "$RPWD/split" ] && printf '[!]Unpack an image first\n' && exit

RDTYPE=`cat "$RPWD/split/ramdisk_compression"`
[ "$RDTYPE" == 'zst' ] && RDTYPE='zstd'

if [[ -d $RPWD/ramdisk ]]
then
    printf '%-40s' '[+]Compressing ramdisk'
    cd $RPWD/ramdisk
    TMP=$RPWD/split/ramdiskcpio.tmp
    RAMDISK=$RPWD/split/ramdisk
    find . | cpio --quiet -H newc -o > $TMP
    if [[ "$RDTYPE" == 'Unknown' || "$RDTYPE" == 'cpio' ]]; then
        mv $TMP $RAMDISK
    else
        $RDTYPE -c $TMP > $RAMDISK
        rm $TMP
    fi
    printf 'Done\n'
fi

if [[ -f "$RPWD/split/mkcmd" ]]
then
    printf '%-40s' '[+]Creating new image'
    sh $RPWD/split/mkcmd && \
        printf 'Done\n'
else
    usage
    exit 1
fi

