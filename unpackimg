#!/bin/bash

source bin/funcs.sh
banner

RPWD=$(pwd)

if [ "$1" == "help" ]
then
    usage
    exit 0
elif [ -f "$1" ]
then
    chkcmds
    ./cleanup
    IMG=$(realpath $1)
else
    printf '[!]Input Error\n\n'
    usage
    exit 1
fi

mkdir -p $RPWD/split $RPWD/ramdisk
cat "$IMG" > $RPWD/split/source.img

printf '%-40s' "[+]Unpacking $(basename ${IMG})"
printf "mkbootimg --output $RPWD/new-boot.img \\" > $RPWD/split/mkcmd
unpack_bootimg --boot_img "$IMG" --format mkbootimg --out $RPWD/split >> $RPWD/split/mkcmd
printf 'Done\n'
RDTYPE=`chkrdtype $RPWD/split/ramdisk | tee $RPWD/split/ramdisk_compression`
if [[ "$RDTYPE" == 'zst' ]]; then
    mv $RPWD/split/ramdisk $RPWD/split/ramdisk.zst
    zstd -qd $RPWD/split/ramdisk.zst
    rm $RPWD/split/ramdisk.zst
elif [[ "$RDTYPE" == 'gzip' ]]; then
    mv $RPWD/split/ramdisk $RPWD/split/ramdisk.gz
    gzip -d $RPWD/split/ramdisk.gz
elif [[ "$RDTYPE" == 'xz' ]]; then
    mv $RPWD/split/ramdisk $RPWD/split/ramdisk.xz
    xz -d $RPWD/split/ramdisk.xz
fi

cd $RPWD/ramdisk
printf '%-40s' '[+]Extracting ramdisk'
cpio -i < $RPWD/split/ramdisk 2> /dev/null
printf 'Done\n'

